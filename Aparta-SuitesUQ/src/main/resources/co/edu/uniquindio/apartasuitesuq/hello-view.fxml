<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.apartasuitesuq.HelloController"
      styleClass="contenido" alignment="CENTER" spacing="16">

    <Label text="Aparta-Suites UQ" styleClass="titulo-pagina"/>
    <Label text="Elige una pantalla" styleClass="texto-suave"/>

    <Button text="Panel de usuario" styleClass="boton-primario"
            prefWidth="240" onAction="#onAbrirPanelUsuario"/>
    <Button text="Folio" styleClass="boton-secundario"
            prefWidth="240" onAction="#onAbrirFolio"/>
</VBox>
