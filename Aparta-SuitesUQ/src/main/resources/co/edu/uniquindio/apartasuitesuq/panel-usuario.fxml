<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.apartasuitesuq.viewController.PanelUsuarioViewController"
      styleClass="contenido" spacing="20">

    <Label text="Panel de usuario" styleClass="titulo-pagina"/>

    <VBox styleClass="tarjeta" spacing="16" maxWidth="360">
        <HBox alignment="CENTER_LEFT" spacing="14">
            <Label fx:id="lblIniciales" styleClass="avatar"/>
            <VBox spacing="4">
                <Label fx:id="lblNombre" styleClass="titulo-seccion"/>
                <Label text="Huésped" styleClass="chip, chip-preparado"/>
            </VBox>
        </HBox>
        <HBox><Label text="Cedula" styleClass="texto-suave"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblCedula" styleClass="texto-fuerte"/></HBox>
        <HBox><Label text="Teléfono" styleClass="texto-suave"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblTelefono" styleClass="texto-fuerte"/></HBox>
        <HBox><Label text="Correo" styleClass="texto-suave"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblCorreo" styleClass="texto-fuerte"/></HBox>
    </VBox>
    <Label text="Mis reservas" styleClass="titulo-seccion"/>
    <TableView fx:id="tablaReservas" prefHeight="220">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código"/>
            <TableColumn fx:id="colApartamento" text="Apartamento"/>
            <TableColumn fx:id="colEntrada" text="Entrada"/>
            <TableColumn fx:id="colSalida" text="Salida"/>
            <TableColumn fx:id="colEstado" text="Estado"/>
            <TableColumn fx:id="colTotal" text="Total"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
