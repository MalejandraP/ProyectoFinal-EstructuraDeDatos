<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.apartasuitesuq.viewController.PanelUsuarioViewController"
            fitToWidth="true" styleClass="scroll-panel-usuario">

    <VBox styleClass="contenido" spacing="20">

        <Label text="Panel de usuario" styleClass="titulo-pagina"/>

        <!-- CONTENEDOR DE DOS COLUMNAS -->
        <HBox spacing="24" alignment="TOP_LEFT">

            <!-- ================= COLUMNA IZQUIERDA ================= -->
            <VBox spacing="20" minWidth="340" prefWidth="360" maxWidth="360">

                <!-- 1. Tarjeta de Perfil -->
                <VBox styleClass="tarjeta" spacing="16">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label fx:id="lblIniciales" styleClass="avatar"/>
                        <VBox spacing="4">
                            <Label fx:id="lblNombre" styleClass="titulo-seccion"/>
                            <Label text="Huésped" styleClass="chip, chip-preparado"/>
                        </VBox>
                    </HBox>
                    <HBox><Label text="Cedula" styleClass="texto-suave"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblCedula" styleClass="texto-fuerte"/></HBox>
                    <HBox><Label text="Nacimiento" styleClass="texto-suave"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblNacimiento" styleClass="texto-fuerte"/></HBox>
                    <HBox><Label text="Teléfono" styleClass="texto-suave"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblTelefono" styleClass="texto-fuerte"/></HBox>
                    <HBox><Label text="Correo" styleClass="texto-suave"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblCorreo" styleClass="texto-fuerte"/></HBox>
                </VBox>

                <!-- 2. Apartamentos favoritos -->
                <VBox styleClass="tarjeta" spacing="12">
                    <Label text="Apartamentos favoritos" styleClass="titulo-seccion"/>
                    <ListView fx:id="listaFavoritos" styleClass="lista-tarjetas" prefHeight="145" minHeight="75"/>
                    <VBox spacing="8">
                        <ComboBox fx:id="cmbApartamentos" promptText="Elige un apartamento" maxWidth="Infinity"/>
                        <HBox spacing="8">
                            <Button text="Agregar" styleClass="boton-primario, boton-sm" onAction="#onAgregarFavorito" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Quitar seleccionado" styleClass="boton-secundario, boton-sm" onAction="#onQuitarFavorito" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- 3. Historial de estancias -->
                <VBox styleClass="tarjeta" spacing="12">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Historial de estancias" styleClass="titulo-seccion"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Más reciente primero" styleClass="fav-detalle"/>
                    </HBox>
                    <ListView fx:id="listaHistorial" styleClass="lista-tarjetas" prefHeight="220" minHeight="100"/>
                </VBox>

            </VBox>

            <!-- ================= COLUMNA DERECHA ================= -->
            <VBox spacing="20" HBox.hgrow="ALWAYS">

                <!-- 1. Mis reservas -->
                <VBox spacing="12">
                    <Label text="Mis reservas" styleClass="titulo-seccion"/>
                    <!-- prefHeight ajustado para 2-3 tarjetas sin robar espacio al Folio -->
                    <ListView fx:id="listaReservas" styleClass="lista-tarjetas" prefHeight="270" minHeight="130"/>
                </VBox>

                <!-- 2. Tarjeta de Folio (debajo de Mis reservas, como en el diseño) -->
                <VBox fx:id="panelFolio" styleClass="tarjeta" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblTituloFolio" text="Folio · Selecciona una reserva" styleClass="titulo-seccion"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Los movimientos no se borran: se corrigen con uno contrario" styleClass="fav-detalle"/>
                    </HBox>

                    <TableView fx:id="tablaFolio" prefHeight="190" minHeight="120">
                        <columns>
                            <TableColumn fx:id="colFolioFecha" text="Fecha"/>
                            <TableColumn fx:id="colFolioTipo" text="Tipo"/>
                            <TableColumn fx:id="colFolioDescripcion" text="Descripción"/>
                            <TableColumn fx:id="colFolioMonto" text="Monto"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- Totales inferiores del Folio -->
                    <HBox alignment="CENTER_LEFT" spacing="24">
                        <VBox spacing="2">
                            <Label text="Total cargos" styleClass="res-etiqueta-monto"/>
                            <Label fx:id="lblTotalCargos" text="\$0" styleClass="res-valor-monto"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="Total pagos" styleClass="res-etiqueta-monto"/>
                            <Label fx:id="lblTotalPagos" text="\$0" styleClass="res-valor-monto"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label text="Saldo pendiente" styleClass="res-etiqueta-monto"/>
                            <Label fx:id="lblSaldoPendiente" text="\$0" styleClass="titulo-pagina"/>
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>

        </HBox>
    </VBox>
</ScrollPane>