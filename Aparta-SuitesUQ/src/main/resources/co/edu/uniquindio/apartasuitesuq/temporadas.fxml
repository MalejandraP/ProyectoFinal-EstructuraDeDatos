<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- H. Temporadas y tarifas: periodos de cada temporada y tarifa por persona por noche de cada apartamento -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.apartasuitesuq.viewController.TemporadasViewController"
            fitToWidth="true">
    <VBox styleClass="contenido" spacing="18">
        <VBox spacing="2">
            <Label text="Temporadas y tarifas" styleClass="titulo-pagina"/>
            <Label text="Las fechas sin periodo son temporada Baja. Una estancia que cruza temporadas se liquida noche por noche."
                   styleClass="texto-suave" wrapText="true"/>
        </VBox>
        <HBox spacing="18">
            <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS" minWidth="440">
                <Label text="Periodos de temporada (ordenados por fecha)" styleClass="titulo-seccion"/>
                <TableView fx:id="tablaPeriodos" prefHeight="280">
                    <columns>
                        <TableColumn fx:id="colPerTemporada" text="Temporada"/>
                        <TableColumn fx:id="colPerDesde" text="Desde"/>
                        <TableColumn fx:id="colPerHasta" text="Hasta (incluido)"/>
                        <TableColumn fx:id="colPerDias" text="Días"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="Sin periodos: todo el año es temporada Baja"/></placeholder>
                </TableView>
                <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                    <VBox spacing="4"><Label text="Temporada" styleClass="texto-suave"/><ComboBox fx:id="cbTemporada" prefWidth="130"/></VBox>
                    <VBox spacing="4"><Label text="Desde" styleClass="texto-suave"/><DatePicker fx:id="dpDesde" prefWidth="150"/></VBox>
                    <VBox spacing="4"><Label text="Hasta" styleClass="texto-suave"/><DatePicker fx:id="dpHasta" prefWidth="150"/></VBox>
                </FlowPane>
                <HBox spacing="8">
                    <Button text="Agregar periodo" styleClass="boton-primario" onAction="#onAgregarPeriodo"/>
                    <Button text="Eliminar seleccionado" styleClass="boton-secundario" onAction="#onEliminarPeriodo"/>
                </HBox>
                <Separator/>
                <Label text="¿Qué temporada es una fecha?" styleClass="texto-suave"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <DatePicker fx:id="dpConsulta" onAction="#onConsultar"/>
                    <Label fx:id="lblConsulta" styleClass="chip, chip-neutro"/>
                </HBox>
            </VBox>

            <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS" minWidth="480">
                <Label text="Tarifa por persona por noche" styleClass="titulo-seccion"/>
                <TableView fx:id="tablaTarifas" prefHeight="280">
                    <columns>
                        <TableColumn fx:id="colTarCodigo" text="Código"/>
                        <TableColumn fx:id="colTarNombre" text="Nombre"/>
                        <TableColumn fx:id="colTarBaja" text="Baja"/>
                        <TableColumn fx:id="colTarMedia" text="Media"/>
                        <TableColumn fx:id="colTarAlta" text="Alta"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
                <Label fx:id="lblAptoTarifa" text="Selecciona un apartamento" styleClass="texto-fuerte"/>
                <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                    <VBox spacing="4"><Label text="Baja" styleClass="texto-suave"/><TextField fx:id="txtBaja" prefWidth="130"/></VBox>
                    <VBox spacing="4"><Label text="Media" styleClass="texto-suave"/><TextField fx:id="txtMedia" prefWidth="130"/></VBox>
                    <VBox spacing="4"><Label text="Alta" styleClass="texto-suave"/><TextField fx:id="txtAlta" prefWidth="130"/></VBox>
                </FlowPane>
                <Button text="Guardar tarifas" styleClass="boton-primario" onAction="#onGuardarTarifas"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
